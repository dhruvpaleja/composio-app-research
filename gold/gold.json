  },
  {
   "app": "Xero",
   "field": "verdict",
   "from": [
    "ready"
   ],
   "to": [
    "ready",
    "ready_with_friction"
   ],
   "why": "Xero moved to tiered developer pricing (Mar 2026); Starter is free but capped on connections, so a multi-tenant toolkit eventually needs a paid tier."
  },
  {
   "app": "Salesforce",
   "field": "verdict",
   "from": [
    "ready"
   ],
   "to": [
    "ready",
    "ready_with_friction"
   ],
   "why": "The agent found a clause I missed: the SFDC API Terms bar 'Commercial Use' of the APIs unless the app is enrolled in the ISV partner program. That is real friction for a commercial toolkit."
  },
  {
   "app": "Datadog",
   "field": "verdict",
   "from": [
    "ready"
   ],
   "to": [
    "ready",
    "ready_with_friction"
   ],
   "why": "Datadog's pricing page now lists Basic hosts as 'Contact sales' while its FAQ still describes a free 5-host tier. With the vendor contradicting itself, both labels are defensible."
  }
